#!/bin/sh
# Must be /bin/sh, not /bin/bash: there is no /bin/bash on a rootless jailbreak,
# so a bash shebang makes this script fail silently on every uninstall.

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    echo "Cleaning up Apple Music Container..."
    
    SHARED_DIR="/var/mobile/Library/DateLyrics"
    if [ -d "$SHARED_DIR" ] && [ ! -L "$SHARED_DIR" ]; then
        if [ "$(basename "$SHARED_DIR")" = "DateLyrics" ]; then
            rm -rf "$SHARED_DIR"
            echo " ✅ Removed DateLyrics files from /var/mobile/Library"
        fi
    fi
    
    for bridge in \
        /var/mobile/Library/Preferences/com.shalamand3r.datelyrics.current-line.txt \
        /var/mobile/Library/Preferences/com.82flex.amlyrics.current-line.txt; do
        if [ -f "$bridge" ]; then
            rm -f "$bridge"
            echo " ✅ Removed lyrics bridge file"
        fi
    done
    
    if [ -d "/var/mobile/Containers/Data/Application" ]; then
        for container in /var/mobile/Containers/Data/Application/*; do
            TARGET="$container/Library/DateLyrics"
            if [ -d "$TARGET" ] && [ ! -L "$TARGET" ] && \
               { grep -q '"host" *: *"music"' "$TARGET/runtime-status.json" 2>/dev/null || \
                 grep -q '"source":"music"' "$TARGET/current-line.txt" 2>/dev/null; }; then
                if [ "$(basename "$TARGET")" = "DateLyrics" ]; then
                    rm -rf "$TARGET"
                    echo " ✅ Removed DateLyrics files from Apple Music container"
                fi
            fi
        done
    fi
    echo "Cleanup complete."
fi

exit 0
