#!/bin/sh

# Rootless package upgrades preserve existing directory modes. Ensure the
# preference loader can traverse and read the bundle after an upgrade.
chmod 755 /var/jb/Library /var/jb/Library/PreferenceBundles \
    /var/jb/Library/PreferenceBundles/DateLyricsPrefs.bundle 2>/dev/null || true
chmod 644 /var/jb/Library/MobileSubstrate/DynamicLibraries/DateLyrics.plist \
    /var/jb/Library/PreferenceLoader/Preferences/DateLyricsPrefs.plist \
    /var/jb/Library/PreferenceBundles/DateLyricsPrefs.bundle/Info.plist \
    /var/jb/Library/PreferenceBundles/DateLyricsPrefs.bundle/Root.plist \
    /var/jb/Library/PreferenceBundles/DateLyricsPrefs.bundle/*.png \
    /var/jb/Library/PreferenceBundles/DateLyricsPrefs.bundle/preview.xml 2>/dev/null || true

exit 0
