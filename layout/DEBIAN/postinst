#!/bin/sh

# Resolve the jailbreak root as seen by this script: roothide runs maintainer
# scripts with "/" mapped to its randomised jbroot (and the real rootfs under
# /rootfs), rootless installs under /var/jb, and rootful installs at "/".
if [ -d /rootfs/var/mobile ]; then
    JBROOT=""
elif [ -d /var/jb ]; then
    JBROOT="/var/jb"
else
    JBROOT=""
fi

# Package upgrades preserve existing directory modes. Ensure the preference
# loader can traverse and read the bundle after an upgrade.
chmod 755 "$JBROOT/Library" "$JBROOT/Library/PreferenceBundles" \
    "$JBROOT/Library/PreferenceBundles/DateLyricsPrefs.bundle" 2>/dev/null || true
chmod 644 "$JBROOT/Library/MobileSubstrate/DynamicLibraries/DateLyrics.plist" \
    "$JBROOT/Library/PreferenceLoader/Preferences/DateLyricsPrefs.plist" \
    "$JBROOT/Library/PreferenceBundles/DateLyricsPrefs.bundle/Info.plist" \
    "$JBROOT/Library/PreferenceBundles/DateLyricsPrefs.bundle/Root.plist" \
    "$JBROOT"/Library/PreferenceBundles/DateLyricsPrefs.bundle/*.png \
    "$JBROOT/Library/PreferenceBundles/DateLyricsPrefs.bundle/preview.xml" 2>/dev/null || true

exit 0
